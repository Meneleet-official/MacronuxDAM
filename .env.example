# Discord bot token (from https://discord.com/developers/applications)
BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ============ LLM PROVIDER ============
# Choose one provider: groq | gemini | deepseek | openrouter
LLM_PROVIDER=groq

# --- Option 1: Groq (FREE tier, recommended) ---
# Get key: https://console.groq.com/keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-120b

# --- Option 2: Google Gemini (FREE tier) ---
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# --- Option 3: DeepSeek (paid) ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Option 4: OpenRouter (free models) ---
# Get key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============ MODERATION & STORAGE ============
# Срок давности страйков в днях (раздел 5.1 правил Macronux™; 0 = бессрочно)
STRIKE_DECAY_DAYS=60

# Опционально: ID бота Akemi (если пусто — определяется автоматически)
AKEMI_BOT_ID=

# Пути к базе данных и лог-файлу
DB_PATH=data/modbot.db
LOG_PATH=data/modbot.log

# ============ PULSE & PTERODACTYL INTEGRATION ============
# Автопоиск контейнеров Pterodactyl (/var/lib/pterodactyl/volumes/*) и мост с веб-панелью Pulse
PULSE_ENABLED=1
PULSE_API_HOST=0.0.0.0
PULSE_API_PORT=8765
PULSE_API_TOKEN=
# Дополнительный путь к папке сервера Pterodactyl (если нестандартный)
PULSE_BRIDGE_DIRS=

# Если сервер Minecraft находится на другом хостинге с панелью Pterodactyl (Client API):
PTERODACTYL_URL=
PTERODACTYL_API_KEY=
PTERODACTYL_SERVER_ID=


